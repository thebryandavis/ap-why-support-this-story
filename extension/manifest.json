{
  "manifest_version": 3,
  "name": "AP · Why Support This Story",
  "version": "1.0",
  "description": "Generates contextual donation messaging for AP News stories using AI.",
  "permissions": [
    "storage",
    "activeTab"
  ],
  "host_permissions": [
    "https://apnews.com/*",
    "https://api.openai.com/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Why Support This Story"
  },
  "content_scripts": [
    {
      "matches": ["https://apnews.com/*"],
      "js": ["content.js"],
      "css": ["content.css"],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "16":  "icons/icon16.png",
    "48":  "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
